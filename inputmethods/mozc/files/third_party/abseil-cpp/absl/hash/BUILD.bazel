load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "hash",
    linkopts = [
        "-labsl_hash",
    ],
    deps = [
        ":city",
        ":weakly_mixed_integer",
        "//absl/base:config",
        "//absl/base:core_headers",
        "//absl/base:endian",
        "//absl/base:prefetch",
        "//absl/container:fixed_array",
        "//absl/functional:function_ref",
        "//absl/meta:type_traits",
        "//absl/numeric:bits",
        "//absl/numeric:int128",
        "//absl/strings",
        "//absl/types:optional",
        "//absl/types:variant",
        "//absl/utility",
    ],
)
cc_library(
    name = "hash_testing",
    deps = [
        ":spy_hash_state",
        "//absl/meta:type_traits",
        "//absl/strings",
        "//absl/types:variant",
        "@googletest//:gtest",
    ],
)
cc_library(
    name = "spy_hash_state",
    visibility = ["//visibility:private"],
    deps = [
        ":hash",
        ":weakly_mixed_integer",
        "//absl/strings",
        "//absl/strings:str_format",
    ],
)
cc_library(
    name = "city",
    linkopts = [
        "-labsl_city",
    ],
    deps = [
        "//absl/base:config",
        "//absl/base:core_headers",
        "//absl/base:endian",
    ],
)
cc_library(
    name = "weakly_mixed_integer",
    visibility = [
        "//absl/container:__pkg__",
        "//absl/strings:__pkg__",
        "//absl/types:__pkg__",
    ],
    deps = [
        "//absl/base:config",
    ],
)
