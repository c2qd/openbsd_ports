load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "civil_time",
    linkopts = [
        "-labsl_civil_time",
    ],
    visibility = ["//visibility:public"],
    deps = ["//absl/base:config"],
)
cc_library(
    name = "time_zone",
    linkopts = [
        "-labsl_time_zone",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":civil_time",
        "//absl/base:config",
    ] + select(
        {
            "//conditions:default": [],
        },
    ),
)
cc_library(
    name = "test_time_zone_names",
    visibility = ["//visibility:private"],
    deps = ["//absl/base:config"],
)
