    linkopts = [
        "-labsl_log_internal_check_op",
    ],
    visibility = ["//absl/log:__pkg__"],
    deps = [
        ":nullguard",
        ":nullstream",
        ":strip",
        "//absl/base",
        "//absl/base:config",
        "//absl/base:core_headers",
        "//absl/base:nullability",
        "//absl/debugging:leak_check",
        "//absl/strings",
        "//absl/strings:has_ostream_operator",
    ],
)
