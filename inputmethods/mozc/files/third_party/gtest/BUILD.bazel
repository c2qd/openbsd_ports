load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "gtest",
    linkopts = [
        "-lgtest",
        "-lgmock",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "gtest_main",
    linkopts = [
        "-lgtest_main",
    ],
    visibility = ["//visibility:public"],
    deps = [":gtest"],
)

alias(
    name = "gmock",
    actual = ":gtest",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "gmock_main",
    linkopts = [
        "-lgmock_main",
    ],
    visibility = ["//visibility:public"],
    deps = [":gtest"],
)
